{
  "imports": {
    "@jhordycg/json-server": "jsr:@jhordycg/json-server@0.2.0"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "unstable": ["detect-cjs", "tsgo"],
  "tasks": {
    "dev": "deno serve -P main.ts",
    "build": "deno bundle --minify --inline-imports --outdir dist main.ts"
  },
  "deploy": {
    "org": "jhordycg",
    "app": "opendata"
  }
}

