{
  "imports": {
    "@jhordycg/json-server": "jsr:@jhordycg/json-server@0.1.2",
    "@std/path": "jsr:@std/path@1.1.5"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "tasks": {
    "dev": "deno serve -P main.ts"
  },
  "deploy": {
    "app": "opendata",
    "org": "jhordycg",
    "runtime": {
      "cwd": ".",
      "entrypoint": "main.ts",
      "mode": "dynamic"
    }
  }
}
